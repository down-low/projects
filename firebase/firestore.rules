rules_version = '2';
// Access rules for the tour schedule on Firebase. They mirror the claude.ai page rules
// (python3 tools/build_artifact.py --capabilities), where the page's "admin" level is Editor access, and the data
// model in FIREBASE_PLAN.md. Roles are custom claims {active, role, pos}, set only by the functions (functions/index.js).
// Tests: firebase/tests/rules.test.js.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function active() { return signedIn() && request.auth.token.get('active', false) == true; }
    function role() { return active() ? request.auth.token.get('role', null) : null; }
    function isAdmin() { return role() == 'admin'; }
    function isEditor() { return role() == 'editor' || role() == 'admin'; }
    function myPos() { return active() && request.auth.token.get('pos', null) is string ? request.auth.token.pos : null; }
    function data() { return request.resource.data; }
    function only(fields) { return data().diff(resource.data).affectedKeys().hasOnly(fields); }

    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function optDate(m, k) { return !(k in m) || m[k] == null || isDate(m[k]); }
    function rangeOk(m) { return isDate(m.start) && optDate(m, 'end') && (!('end' in m) || m.end == null || m.end >= m.start); }
    function optText(m, k, n) { return !(k in m) || m[k] == null || (m[k] is string && m[k].size() <= n); }
    function isKey(v) { return v is string && v.size() > 0 && v.size() <= 80; }
    function ranks() { return ['Battalion Chief', 'Rescue Captain', 'Captain', 'Lieutenant', 'ISS', 'FF/Paramedic', 'Firefighter', 'Pilot', 'Marine Engineer']; }

    // Field checks for editors, as server.py (admins skip them, so imported records always load).
    function statusOk(m) { return isKey(m.pos) && m.code in ['VA', 'S', 'D', 'WE'] && rangeOk(m) && optText(m, 'note', 500); }
    function tourOk(m) { return isKey(m.pos) && m.tour is int && m.tour >= 1 && m.tour <= 31 && isDate(m.effective) && optText(m, 'note', 500); }
    function coverOk(m) {
      return isKey(m.coverKey) && isKey(m.targetPos) && m.coverKey != m.targetPos && rangeOk(m) && optText(m, 'note', 500) &&
        (!('kind' in m) || m.kind == null || m.kind in ['acting', 'cover', 'shadow', 'extra']);
    }
    function personOk(m) {
      return m.name is string && m.name.size() >= 2 && m.name.size() <= 80 && m.rank in ranks() &&
        (!('tour' in m) || m.tour == null || (m.tour is int && m.tour >= 1 && m.tour <= 31)) &&
        (!('emplId' in m) || m.emplId == null || (m.emplId is string && m.emplId.matches('^[A-Z]{2}[0-9]{4}$')));
    }
    function recordWrite(ok) { return isAdmin() || (isEditor() && ok); }
    // A member marks one of their own days VA or S from the day drawer (self: true), and may delete only that record.
    function ownDayOk(m) {
      return myPos() != null && m.pos == myPos() && m.code in ['VA', 'S'] && isDate(m.start) && m.end == m.start &&
        m.self == true && m.createdBy == request.auth.uid &&
        m.keys().hasOnly(['pos', 'name', 'code', 'start', 'end', 'note', 'self', 'createdAt', 'createdBy']) &&
        optText(m, 'name', 80) && optText(m, 'note', 500);
    }
    function ownDay(r) { return myPos() != null && r.self == true && r.createdBy == request.auth.uid && r.pos == myPos(); }

    // Schedule records: everyone approved reads; editors and admins write; members add or remove their own one-day VA / S.
    match /statuses/{id} {
      allow read: if active();
      allow create: if recordWrite(statusOk(data())) || ownDayOk(data());
      allow update: if recordWrite(statusOk(data()));
      allow delete: if isEditor() || ownDay(resource.data);
    }
    match /tourChanges/{id} {
      allow read: if active();
      allow create, update: if recordWrite(tourOk(data()));
      allow delete: if isEditor();
    }
    match /covers/{id} {
      allow read: if active();
      allow create, update: if recordWrite(coverOk(data()));
      allow delete: if isEditor();
    }
    match /people/{id} {
      allow read: if active();
      allow create, update: if recordWrite(personOk(data()));
      allow delete: if isEditor();
    }
    match /staffing/{company} {
      allow read: if active();
      allow write: if isEditor();
    }
    match /assignments/{id} {   // move log
      allow read: if active();
      allow write: if isEditor();
    }
    // Employee cards: a roster seat's name, rank or Employee ID over the files.
    match /rosterOverrides/{pos} {
      allow read: if active();
      allow write: if isAdmin();
    }

    // Private: staff-list cell numbers (admins only; a trade's poster gets their invitees' cells through createInvite,
    // audited), birth and hire dates (owner and admins).
    match /staffCells/{key} {
      allow read, write: if isAdmin();
    }
    match /profiles/{key} {
      allow read: if isAdmin() || (myPos() != null && key == myPos());
      // A member sets their own dates; the academy class (classNo) is set by admins.
      allow write: if isAdmin() || (myPos() != null && key == myPos() &&
        request.resource.data.get('classNo', null) == (resource == null ? null : resource.data.get('classNo', null)));
    }
    // The claude.ai page's "This is me" records, kept for reference after the import.
    match /members/{id} {
      allow read, write: if isAdmin();
    }

    // Contact info: the owner's own record; shared ones are readable by everyone approved.
    match /contacts/{uid} {
      allow read: if isAdmin() || (signedIn() && uid == request.auth.uid) || (active() && resource.data.share == true);
      allow create, update: if (active() && uid == request.auth.uid && data().pos == myPos() && data().share is bool &&
          optText(data(), 'contactEmail', 254) && optText(data(), 'phoneMobile', 40) && optText(data(), 'phoneOther', 40)) || isAdmin();
      allow delete: if (signedIn() && uid == request.auth.uid) || isAdmin();
    }

    // Accounts: created and changed by the functions; a person reads their own and sets their own alerts, tabs and
    // app-notification tokens. (alertLog, alertState and alertTokens, used by the alert functions, match no rule.)
    match /users/{uid} {
      allow read: if (signedIn() && uid == request.auth.uid) || isAdmin();
      allow update: if signedIn() && uid == request.auth.uid && only(['alerts', 'prefs', 'pushTokens']);
    }

    // Shift trades. As on the claude.ai page, every approved member can read them; the page shows each person only
    // what's theirs or on the board. A set trade carries its cover and TR records (legs).
    /* A set trade's legs become cover and TR records on everyone's schedule (store.js tradeLegs), so a poster may only
       write the ones TourMath.pickLegs makes: the taker covers the posted seat and the poster is TR on the trade day,
       and for a swap the reverse on the swap day; the taker must be the one who answered (their reply). No legs is fine. */
    function coverLeg(l, who, seat, day) {
      return l.kind == 'covers' && l.coverKey == who && isKey(seat) && l.targetPos == seat && l.start == day && l.end == day;
    }
    function trLeg(l, who, day) { return l.kind == 'statuses' && l.pos == who && l.code == 'TR' && l.start == day && l.end == day; }
    function legsOk(t) {
      return !('legs' in t) || t.legs == null || (t.legs is list && (t.legs.size() == 0 ||
        ((t.legs.size() == 2 || t.legs.size() == 4) && isKey(t.replyId) &&
          get(/databases/$(database)/documents/tradeReplies/$(t.replyId)).data.takerKey == t.takerKey &&
          coverLeg(t.legs[0], t.takerKey, t.seatPos, t.date) && trLeg(t.legs[1], t.posterKey, t.date) &&
          (t.legs.size() == 2 || (isDate(t.proposal.swapDate) && t.proposal.swapDate != t.date &&
            coverLeg(t.legs[2], t.posterKey, t.legs[2].targetPos, t.proposal.swapDate) && trLeg(t.legs[3], t.takerKey, t.proposal.swapDate))))));
    }
    match /trades/{id} {
      allow read: if active();
      allow create: if isAdmin() || (myPos() != null && data().posterKey == myPos() && data().status == 'open');
      allow update: if isAdmin() || (myPos() != null && resource.data.posterKey == myPos() && data().posterKey == myPos() &&
          only(['audience', 'status', 'replyId', 'takerKey', 'proposal', 'setAt', 'legs', 'cancelledAt', 'note', 'seatPos', 'reopenedAt']) && legsOk(data()));
      allow delete: if isAdmin();
    }
    match /tradeReplies/{id} {
      allow read: if active();
      // Your own answer, or (via "poster") an answer the poster got by text and records for someone on their trade.
      // Answers from an invite link (via "link", verified) are written only by the functions.
      allow create: if isAdmin() || (myPos() != null && !('verified' in data()) && data().get('via', null) != 'link' &&
          (data().takerKey == myPos() ||
          (data().via == 'poster' && get(/databases/$(database)/documents/trades/$(data().tradeId)).data.posterKey == myPos())));
      allow update, delete: if isAdmin();
    }

    // Launch invites: who an admin has texted the sign-up link to (Admin → Invite people).
    match /launchInvites/{pos} {
      allow read, write: if isAdmin();
    }

    // Trade invites (personal links): made and read only by the functions (createInvite, inviteInfo, redeemInvite).
    match /tradeInvites/{code} {
      allow read, write: if false;
    }

    // Corrections: one record per member (corrections/<uid>), read and written by that member; editors and admins
    // read and handle all of them.
    match /corrections/{uid} {
      allow read: if isEditor() || (active() && uid == request.auth.uid);
      allow write: if isEditor() || (active() && uid == request.auth.uid);
    }

    // Feedback about the app: the same shape and access as corrections.
    match /feedback/{uid} {
      allow read: if isEditor() || (active() && uid == request.auth.uid);
      allow write: if isEditor() || (active() && uid == request.auth.uid);
    }

    // Overtime days: overtime/<doc> = {pos, name, days: {<date>: {kind, hours}}}, read by everyone signed in. <doc> is
    // the member's uid (their own seat only) or seat-<pos> for marks an admin enters. Notes are private:
    // overtimeNotes/<doc> = {notes: {<date>: text}}, read and written by that member and admins.
    match /overtime/{doc} {
      allow read: if active();
      allow create, update: if isAdmin() || (active() && doc == request.auth.uid && myPos() != null && data().pos == myPos() &&
        data().days is map && data().days.size() <= 400);
      allow delete: if isAdmin() || (active() && doc == request.auth.uid);
    }
    match /overtimeNotes/{doc} {
      allow read, write: if isAdmin() || (active() && doc == request.auth.uid);
    }

    // Announcements (Admin → Send announcement): written only by the announce function; admins read the history.
    match /announcements/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // What each person sees in the app: notices/<uid> = {items, dismissed}. Items come only from the function; the owner
    // reads them and marks them dismissed.
    match /notices/{uid} {
      allow read: if isAdmin() || (active() && uid == request.auth.uid);
      allow update: if active() && uid == request.auth.uid && only(['dismissed']) && data().dismissed is map;
    }

    // settings/site {mode: "test" | "live"}: the "Test copy" banner until cut-over (CUTOVER.md).
    match /settings/{doc} {
      allow read: if active();
      allow write: if isAdmin();
    }

    match /audit/{id} {
      allow read: if isAdmin();
    }
  }
}
